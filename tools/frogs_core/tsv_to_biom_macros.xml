<?xml version="1.0"?>
<macros>
    <token name="@TSV_TO_BIOM_CMD_LINE@">
        tsv_to_biom.py
            --input-tsv '$input_tsv'

            #if $input_multi_affi
                --input-multi-affi '$input_multi_affi'
            #end if

            --output-biom '$output_biom'
            #if $extract_fasta == "yes"
                --output-fasta '$output_fasta'
            #end if
    </token>

    <xml name="tsv_to_biom_inputs">
        <!-- Files -->
        <param argument="--input-tsv" type="data" format="tsv,tabular" label="Abundance file (format: TSV)" help="The TSV file to convert." />
        <param argument="--input-multi-affi" type="data" format="tsv,tabular" label="Multi_affiliation File(format: TSV)" help="TSV file describing multi_affiliation blast results." optional="true" />

        <!-- Parameters -->
        <param name="extract_fasta" type="select" display="radio" label="Extract seeds in FASTA file" help="If there is a 'seed_sequence' column in your TSV abundance table, you can extract seed sequences into a separate FASTA file." >
            <option value="yes">Yes</option>
            <option value="no" selected="true">No</option>
		</param>
    </xml>
</macros>
