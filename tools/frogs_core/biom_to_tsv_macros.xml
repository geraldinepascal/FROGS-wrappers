<?xml version="1.0"?>
<macros>
    <token name="@BIOM_TO_TSV_CMD_LINE@">
        biom_to_tsv.py
            --input-biom '$input_biom'

            #if '$input_fasta'
                --input-fasta '$input_fasta'
            #end if

            --output-tsv '$output_tsv'
            #if $extract_multi_align == "yes"
                --output-multi-affi '$output_multihit'
            #end if
    </token>

    <xml name="biom_to_tsv_inputs">
        <!-- Files -->
        <param argument="--input-fasta" type="data" format="fasta" label="Sequence file (.fasta)" help="The sequences file. If you use this option the sequences will be added to the TSV." />
        <param argument="--input-biom" type="data" format="biom1" label="Abundance file (.biom)" help="The abundance file to convert." />
        
		<!-- Parameters -->
		<param name="extract_multi_align" type="select" display="radio"  label="Extract multi-affiliation" help="This option will extract information about multiple blast affiliation in a second TSV file.">
            <option value="yes" selected="true">Yes</option>
            <option value="no" >No</option>
		</param>
    </xml>

    <!-- Test -->
    <xml name="biom_to_tsv_test_input">
        <param name="input_fasta" value="references/09-normalisation.fasta" />
        <param name="input_biom" value="references/09-normalisation.biom" />

        <param name="extract_multi_align" value="yes" />
    </xml>
    
    <xml name="biom_to_tsv_test_output">
        <output name="output_tsv" file="references/12-biom2tsv.tsv" compare="diff" lines_diff="0" />
        <output name="output_multihit" file="references/12-biom2tsv-affiliation_multihit.tsv" compare="diff" lines_diff="0" />
    </xml> 
</macros>
