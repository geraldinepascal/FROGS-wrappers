<?xml version="1.0"?>
<macros>
    <token name="@TAXONOMIC_AFFILIATION_CMD_LINE@"><![CDATA[
        #set $reference_filename = str( $ref_file.fields.path )
        
        @EXPORT_GALAXY_MEMORY_GB@
        
        taxonomic_affiliation.py
            @CPUS@
            --java-mem \$GALAXY_MEMORY_GB

            --input-biom '$input_biom'
            --input-fasta '$input_fasta'
            --reference '${reference_filename}'

            #if $rdp == "yes"
            --rdp
            #end if
            --taxonomy-ranks $taxonomic_ranks
            
            --output-biom '$output_biom'
            --html '$html'
            --nb-cpus 8
            --java-mem 16

    ]]></token>

    <xml name="taxonomic_affiliation_inputs">
        <!-- Files -->
        <param argument="--input-fasta" type="data" format="fasta" label="Sequence file (.fasta)" help="The sequence file to be taxonomically affiliated." />/>
        <param argument="--input-biom" type="data" format="biom1" label="Abundance file (.biom)" help="The abundance file linked to the sequence to be taxonomically affiliated." />

         <!-- Database Choice -->
        <param name="ref_file" type="select" label="Choose the reference database" help="Select the reference database from the list.">
            <options from_data_table="frogs_db"/>
            <validator type="no_options" message="No database is available"/>
        </param>

        <!-- Parameters -->
        <param argument="--rdp" type="select" display="radio" label="Run RDP taxonomic affiliation in addition to BLAST" help="Taxonomic affiliation is performed using BLAST. Enabling this option also runs taxonomic affiliation with the RDP Classifier (default: No).">
            <option value="yes" >Yes</option>
            <option value="no" selected="true" >No</option>
		</param>
        <expand macro="taxonomic_ranks"/>

    </xml>
</macros>
