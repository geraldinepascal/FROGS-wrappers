<?xml version="1.0"?>
<macros>
    <token name="@BIOM_TO_STD_BIOM_CMD_LINE@">
        biom_to_stdBiom.py
            --input-biom '$input_biom'
            --output-biom '$output_std_biom'
            --output-metadata '$output_multihit'
    </token>

    <xml name="biom_to_std_biom_inputs">
        <!-- Files -->
        <param argument="--input-biom" type="data" format="biom1" label="Abundance file (format: BIOM)" help="The BIOM file to convert." />
    </xml>
</macros>