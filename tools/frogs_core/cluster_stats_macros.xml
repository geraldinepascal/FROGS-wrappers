<?xml version="1.0"?>
<macros>
    <token name="@CLUSTER_STATS_CMD_LINE@">
        cluster_stats.py
            --input-biom '$input_biom'
            --html '$html'
    </token>

    <xml name="cluster_stats_inputs">
        <!-- Files -->
        <param argument="--input-biom" name="input_biom" type="data" format="biom1" label="Abundance file (format: BIOM)" help="The abundance file to filter." />
    </xml>
</macros>