<?xml version="1.0"?>
<macros>
    <token name="@REMOVE_CHIMERA_CMD_LINE@">
        remove_chimera.py
            @CPUS@
            --input-fasta '$input_fasta' 
            --input-biom '$input_biom'
            
            --output-biom '$output_biom'
            --output-fasta '$output_fasta'
            --html '$html'

    </token>

    <xml name="remove_chimera_inputs">
        <!-- Files -->
        <param argument="--input-fasta" name="input_fasta" type="data" format="fasta" label="Sequence file (format: FASTA)" help="The sequence file to filter." />/>
        <param argument="--input-biom" name="input_biom" type="data" format="biom1" label="Abundance file (format: BIOM)" help="The abundance file to filter." />
    </xml>
</macros>