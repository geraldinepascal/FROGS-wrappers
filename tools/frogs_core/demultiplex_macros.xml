<?xml version="1.0"?>
<macros>
    <token name="@DEMULTIPLEX_CMD_LINE@">
        demultiplex.py
            --input-barcode '$input_barcode'        
            #if str( $fastq_input.fastq_input_type ) == "paired":
                --input-R1 '${fastq_input.input_R1}'
                --input-R2 '${fastq_input.input_R2}'
            #else:
                --input-R1 '${fastq_input.input_R1}'
            #end if

            --mismatches $mismatches
            --end '$end'

            --summary '$output_count'
            --output-demultiplexed '$output_demultiplexed'
            --output-undemultiplexed '$output_undemultiplexed'
    </token>

    <xml name="demultiplex_inputs">
        <!-- Files -->
        <param argument="--input-barcode" format="tsv,tabular" type="data" label="Barcode file" help="This file describes barcodes and samples (one line by sample tabulated separated from barcode sequence(s)). See Help section" />
        <conditional name="fastq_input">
              <param name="fastq_input_type" type="select" display="radio" label="Single or Paired-end reads" help="Select between paired and single-end data">
                  <option value="single">Single</option>
                <option value="paired">Paired</option>
            </param>
              <when value="paired">
                <param argument="--input-R1" type="data" format="fastq" label="Reads 1" help="R1 FASTQ file of paired-end reads." />
                <param argument="--input-R2" type="data" format="fastq" label="Reads 2" help="R2 FASTQ file of paired-end reads." />
            </when>
            <when value="single">
                <param argument="--input-R1" type="data" format="fastq" label="Select the set of reads" help="Specify dataset of your single end reads"/>
              </when>
        </conditional>
        <!-- Parameters -->
        <param argument="--mismatches" type="integer"  value="0" label="Barcode mismatches" help="Number of mismatches allowed in barcode"/>
        <param argument="--end" type="select" display="radio" label="Barcode on which end ?" help="The barcode is placed either at the beginning of the forward read or of the reverse read or both?">
            <option value="bol" selected="true">Forward (bol)</option>
            <option value="eol">Reverse (eol)</option>
            <option value="both">Both ends (both)</option>
        </param>
    </xml>

    <!-- Test -->
    <xml name="demultiplex_test_input">
        <param name="input_barcode" value="input/formation.barcode.txt" />
        <conditional name="fastq_input">
            <param name="fastq_input_type" value="single" />
            <param name="input_R1" value="input/formation_small.fastq.gz" />
        </conditional>
        <param name="mismatches" value="1" />
        <param name="end" value="both" />
    </xml>

    <xml name="demultiplex_test_output">
        <output name="output_count" file="references/demultiplex_summary.txt" compare="diff" lines_diff="0" />
        <output name="output_demultiplexed" file="references/demultiplexed.tar.gz" compare="sim_size" delta="50" />
        <output name="output_undemultiplexed" file="references/undemultiplexed.tar.gz" compare="sim_size" delta="50" />
    </xml>
</macros>